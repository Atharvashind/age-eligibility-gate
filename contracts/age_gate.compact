pragma language_version >= 0.22;

import CompactStandardLibrary;

export ledger min_age_requirement: Uint<32>;
export ledger issued_credentials: Map<Bytes<32>, Boolean>;

export ledger admin: Bytes<32>;

constructor(min_age: Uint<32>, admin_pk: Bytes<32>) {
  min_age_requirement = disclose(min_age);
  admin = disclose(admin_pk);
}

witness localSecretKey(): Bytes<32>;
witness birthYear(): Uint<32>;
witness credentialSalt(): Bytes<32>;

export circuit issueCredential(commitment: Bytes<32>): [] {
  assert(disclose(publicKey(localSecretKey())) == admin, "Only admin can issue credentials");
  issued_credentials.insert(disclose(commitment), true);
}

export circuit verifyAge(current_year: Uint<32>): Boolean {
  const commitment = credentialCommitment(birthYear(), credentialSalt());
  assert(issued_credentials.member(disclose(commitment)), "Credential was not issued by the administrator");
  assert(disclose(current_year) >= birthYear(), "Birth year cannot be in the future");
  const age = disclose(current_year) - birthYear();
  assert(age >= min_age_requirement, "User is under the required age");
  
  return disclose(true);
}

export circuit credentialCommitment(year: Uint<32>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "age:credential:"),
    year as Field as Bytes<32>,
    salt
  ]);
}

export circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "agegate:pk:"), sk]);
}
